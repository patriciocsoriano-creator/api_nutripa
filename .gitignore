# ============================================
# 📦 NODE.JS - DEPENDENCIAS
# ============================================
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*
.pnpm-store/
.npm
.eslintcache
.yarn-integrity

# ============================================
# 🔐 VARIABLES DE ENTORNO (MUY IMPORTANTE)
# ============================================
.env
.env.local
.env.*.local
.env.development
.env.production
.env.staging
.env.test
config/local.json
config/secrets.json
*.env
*.env.*

# ============================================
# 📝 LOGS
# ============================================
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
logs/*
!logs/.gitkeep
*.out
*.err

# ============================================
# 🗄️ BASE DE DATOS LOCAL
# ============================================
*.sql
*.sql.gz
*.sql.bz2
*.db
*.sqlite
*.sqlite3
database/*.sql
database/*.dump
database/*.bak
data/
db/
backup/
backups/
*.dump
*.backup

# ============================================
# 📁 ARCHIVOS TEMPORALES Y DE CACHE
# ============================================
tmp/
temp/
.cache/
.npm/
.eslintcache
*.tmp
*.temp
*.swp
*.swo
*~
.DS_Store
Thumbs.db
desktop.ini
ehthumbs.db

# ============================================
