temp_files/
temp_data/
debug/
debug.log

# ============================================
# 🐳 DOCKER (OPCIONAL - Si usas Docker)
# ============================================
# Descomenta si NO quieres subir archivos de Docker
# docker-compose.override.yml
# .docker/

