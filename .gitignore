*.key
*.cert
*.crt
*.p12
*.pfx
*.jks
*.keystore
secrets/
credentials/

# ============================================
# 📦 ARCHIVOS DE COMPILACIÓN
# ============================================
dist/
build/
out/
target/
*.o
*.obj
*.pyc
__pycache__/

# ============================================
# 🧪 TESTING
# ============================================
coverage/
.nyc_output/
test-results/
*.lcov
.jest/

# ============================================
# 🖥️ ARCHIVOS DE SISTEMA
# ============================================
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
desktop.ini
$RECYCLE.BIN/

# ============================================
# 📸 SCREENSHOTS Y CAPTURAS
# ============================================
screenshots/
captures/
captures/*
!captures/.gitkeep

# ============================================
# 📦 UPLOADS Y ARCHIVOS DE USUARIO
# ============================================
uploads/
uploads/*
!uploads/.gitkeep
public/uploads/
public/uploads/*
!public/uploads/.gitkeep
files/
files/*
!files/.gitkeep

# ============================================
# 🗂️ ARCHIVOS ESPECÍFICOS DEL PROYECTO
# ============================================
